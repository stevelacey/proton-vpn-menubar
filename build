#!/bin/bash
# Builds Proton VPN Menu Bar.app into .build/ with Swift Package Manager.
set -euo pipefail

cd "$(dirname "$0")"
app=".build/Proton VPN Menu Bar.app"
rm -rf "$app"
mkdir -p "$app/Contents/MacOS"
cp Info.plist "$app/Contents/"
mkdir -p "$app/Contents/Resources"
cp Resources/* "$app/Contents/Resources/"
# Apple Silicon only, unless --universal adds Intel.
targets=(arm64-apple-macosx14.0)
[[ "${1:-}" == --universal ]] && targets+=(x86_64-apple-macosx14.0)
binaries=()
for target in "${targets[@]}"; do
    swift build -c release --product ProtonVPNMenuBar --triple "$target" >&2
    binaries+=(".build/${target%%14.0}/release/ProtonVPNMenuBar")
done
lipo -create "${binaries[@]}" -output "$app/Contents/MacOS/ProtonVPNMenuBar"
codesign --force --sign - "$app"
echo "$app"
