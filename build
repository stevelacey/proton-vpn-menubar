#!/bin/bash
# Builds Proton VPN Menu Bar.app into .build/, with the Command Line Tools' swiftc.
set -euo pipefail

cd "$(dirname "$0")"
app=".build/Proton VPN Menu Bar.app"
rm -rf "$app"
mkdir -p "$app/Contents/MacOS"
cp Info.plist "$app/Contents/"
mkdir -p "$app/Contents/Resources"
cp Resources/* "$app/Contents/Resources/"
# Apple Silicon only, unless --universal adds Intel.
targets=(arm64-apple-macos14)
[[ "${1:-}" == --universal ]] && targets+=(x86_64-apple-macos14)
binaries=()
for target in "${targets[@]}"; do
    swiftc -O -parse-as-library -target "$target" ProtonVPNMenuBar.swift -o ".build/ProtonVPNMenuBar-$target"
    binaries+=(".build/ProtonVPNMenuBar-$target")
done
lipo -create "${binaries[@]}" -output "$app/Contents/MacOS/ProtonVPNMenuBar"
codesign --force --sign - "$app"
echo "$app"
